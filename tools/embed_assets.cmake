# Generates a C++ source holding the web UI assets as byte arrays.
#   cmake -DOUT=file.cpp -DASSETS="published=source|..." -P embed_assets.cmake
set(code "// Generated by tools/embed_assets.cmake - do not edit.\n#include \"host/ui_server.hpp\"\n\nnamespace esp32sim {\n\n")
set(table "")
set(i 0)
string(REPLACE "|" ";" ASSETS "${ASSETS}")
foreach(entry IN LISTS ASSETS)
  string(FIND "${entry}" "=" eq)
  string(SUBSTRING "${entry}" 0 ${eq} name)
  math(EXPR from "${eq} + 1")
  string(SUBSTRING "${entry}" ${from} -1 src)
  file(READ "${src}" hex HEX)
  string(LENGTH "${hex}" len)
  math(EXPR size "${len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  # Break the initializer into lines of 8 bytes.
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],))" "\\1\n" hex "${hex}")
  string(APPEND code "static const unsigned char asset${i}[] = {\n${hex}0};\n\n")
  string(APPEND table "    {\"${name}\", asset${i}, ${size}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND code "extern const UiAsset kUiAssets[] = {\n${table}};\nextern const size_t kUiAssetCount = ${i};\n\n}  // namespace esp32sim\n")
file(WRITE "${OUT}.tmp" "${code}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
